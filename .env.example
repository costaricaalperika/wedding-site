# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Admin API (DELETE /api/alperduygu/guests/[id]) — sadece sunucuda; asla istemciye vermeyin
# Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel (/alperduygu) — sunucuda ve Vercel'de tanımlayın (NEXT_PUBLIC kullanmayın)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# En az 16 karakter rastgele dize (ör. openssl rand -hex 32)
ADMIN_SESSION_SECRET=
